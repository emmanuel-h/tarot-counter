<?xml version="1.0" encoding="utf-8"?>
<!--
    Window-level colours (issue #205). Compose reads its colours from
    ui/theme/Color.kt; these XML copies are only for what Android draws before
    Compose starts: the splash screen and the window background.
-->
<resources>
    <!-- SalonIvory: page background of the light theme. -->
    <color name="salon_ivory">#FFF6F1E7</color>
    <!-- NightFeltGround: page background of the dark theme. -->
    <color name="night_felt_ground">#FF101A15</color>
</resources>
