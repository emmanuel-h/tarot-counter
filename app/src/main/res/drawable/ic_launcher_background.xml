<?xml version="1.0" encoding="utf-8"?>
<!--
    Background layer — "Salon" (issue #205): felt green with a brass double
    hairline ring, the same ornament as the in-app SuitDivider.

    The rings stay inside the 72 dp safe zone (radius ≤ 36 around the centre),
    so every launcher mask (circle, squircle, rounded square) shows them whole.
      #1F4D3A  felt green (tarotColors.felt)
      #B08A3E  brass      (tarotColors.brass)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Felt -->
    <path
        android:fillColor="#1F4D3A"
        android:pathData="M0,0h108v108H0z" />

    <!-- Outer brass hairline ring, radius 34 around (54, 54) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#B08A3E"
        android:strokeWidth="0.9"
        android:pathData="M20,54 A34,34,0,1,1,88,54 A34,34,0,1,1,20,54 Z" />

    <!-- Inner brass hairline ring, radius 32 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#B08A3E"
        android:strokeWidth="0.45"
        android:pathData="M22,54 A32,32,0,1,1,86,54 A32,32,0,1,1,22,54 Z" />

</vector>
